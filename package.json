{
  "name": "workspace",
  "private": true,
  "type": "module",
  "version": "1.0.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "prisma generate && vite build && node scripts/build-server.mjs",
    "start": "CHECKPOINT_DISABLE=1 node scripts/migrate.mjs && exec node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "demo:load": "tsx scripts/load-demo-data.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@hono/node-server": "2.1.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/themes": "3.3.0",
    "better-auth": "1.7.14",
    "hono": "4.13.14",
    "ical.js": "2.2.1",
    "nodemailer": "10.2.1",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "smtp-server": "3.21.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "mysql2": "3.24.5",
    "deepmerge-ts": "8.0.2"
  }
}
