# Settings for Workletto. Copy this file to .env (cp .env.example .env), then fill it in.
# Keep .env private: it holds your secrets.

# ── Installing with Docker Compose ──────────────────────────────────────────
# Fill in these three, then run: docker compose up -d
# On Render you don't need this file: Render asks for SETUP_CODE and makes the rest.

# A long random value that signs sign-in sessions. Make one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# The address people type into the browser, for example https://time.yourstudio.com
BETTER_AUTH_URL=

# At least 16 characters. The first-run setup screen asks for it once, when you
# create the admin account. Make one with:
#   openssl rand -hex 12
SETUP_CODE=

# How many proxies sit between the internet and the app. 1 on Render or behind the
# HTTPS proxy from the Docker instructions, so the app knows each visitor's address
# (for slowing down password guessing); 0 if browsers reach the app's port directly.
TRUST_PROXY=1

# ── Local development only (npm run dev) ────────────────────────────────────
# Docker Compose ignores this section. For development, fill the three values
# above with throwaway ones, for example:
#   BETTER_AUTH_SECRET=dev-only-secret-not-for-real-installs-0123456789
#   BETTER_AUTH_URL=http://localhost:5173
#   SETUP_CODE=local-setup-code-1234
# These two example values are refused when NODE_ENV=production, so a real install
# can't run on them by accident.

# Postgres 17 on your computer. Tests use a second database with the same name
# ending in _test (here work_test) on the same server.
DATABASE_URL=postgresql://work:work@localhost:5432/work_dev
